PLAYWRIGHT_BROWSERS_PATH=/Volumes/E Drive/Dev/.cache/ms-playwright
TMPDIR=/Volumes/E Drive/Dev/.scratch/tmp
LHCI_DIR=.lighthouseci
# Placeholder HTTPS origin for local build+test only (technical-plan.md §A8/§B S06.06 —
# EVAL-017/tests/e2e/eval-017.spec.ts asserts literal absolute `https://` OG/canonical/Twitter
# URLs, which the `lib/seo.ts` env chain can only produce when NEXT_PUBLIC_SITE_URL is set).
# `dotenv` never overrides a variable already present in the environment, so a real
# NEXT_PUBLIC_SITE_URL set on Vercel (TKT-50/53) always wins over this file.
NEXT_PUBLIC_SITE_URL=https://portfolio-clay.example
