{
  "//": "Lighthouse CI — desktop (technical-plan.md §A9 / §B S07.04). Same budgets as mobile but with",
  "//2": "the desktop preset. Tracer collects `/` only, assertions `warn` (informational until S11.01).",
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start",
      "url": ["http://127.0.0.1:3000/"],
      "numberOfRuns": 3,
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 90000,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "aggregationMethod": "median",
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["warn", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.95 }],
        "categories:seo": ["warn", { "minScore": 0.95 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.05 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/desktop"
    }
  }
}
