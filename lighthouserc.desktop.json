{
  "//": "Lighthouse CI — desktop (technical-plan.md §A9 / §B S11.01). Same budgets as mobile with the",
  "//2": "desktop preset; TKT-07b flips assertions to level `error` and uses the four-route sweep:",
  "//3": "/, /work, /work/teachspark, /about — the §A9/EVAL-004 route list. /about swapped back in at",
  "//4": "TKT-42 (M-006), replacing the /contact stand-in used pre-TKT-42. Thresholds are NEVER lowered",
  "//5": "to pass (EV2).",
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start",
      "url": [
        "http://127.0.0.1:3000/",
        "http://127.0.0.1:3000/work",
        "http://127.0.0.1:3000/work/teachspark",
        "http://127.0.0.1:3000/about"
      ],
      "numberOfRuns": 3,
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 90000,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "aggregationMethod": "median",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/desktop"
    }
  }
}
