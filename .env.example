# Absolute HTTPS base URL used for canonical + Open Graph URLs (metadataBase).
# Leave blank locally; on Vercel it falls back to the deployment URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# RAG_ENDPOINT — reserved, unused in v1 (future /api/ask provider). Do not set yet.
# RAG_ENDPOINT=

# ---- Mixpanel analytics (TASK-194) — full guide: docs/analytics.md --------------------------------------
# All NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time. A Mixpanel project token is
# public by design (it can only add events), but keep real values in Vercel, never in this file.
#
# The Mixpanel project token (Project Settings → Access Keys → Project Token, 32 hex characters).
# EMPTY = analytics is a complete no-op: no script is loaded and no request is made.
# Production on Vercel: set it for the "Production" environment only. Preview/Development: leave empty
# (or give them a SEPARATE test project's token together with NEXT_PUBLIC_ANALYTICS_ENV=staging).
NEXT_PUBLIC_MIXPANEL_TOKEN=
# Optional. development | staging | production. Localhost and *.vercel.app previews send nothing unless this
# is set; when set it becomes the `environment` property on every event. On the live site leave it empty
# (it then reports "production") or set "production".
NEXT_PUBLIC_ANALYTICS_ENV=
# Optional. Mixpanel data residency: https://api-js.mixpanel.com (default, US), https://api-eu.mixpanel.com
# (EU) or https://api-in.mixpanel.com (India). Anything else disables analytics. Must match the project's region.
NEXT_PUBLIC_MIXPANEL_API_HOST=
# Optional. opt-out (default: tracking starts, the visitor can stop it) or opt-in (nothing is sent until a
# consent banner stores "granted"). Do Not Track and Global Privacy Control always win.
NEXT_PUBLIC_ANALYTICS_CONSENT=
# Optional, set by Vercel itself when "Automatically expose System Environment Variables" is on: lets a
# Vercel *preview* build stay silent even on a custom preview domain.
# NEXT_PUBLIC_VERCEL_ENV=
